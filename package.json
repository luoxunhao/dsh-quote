{
  "name": "dsh-quote",
  "version": "0.1.0",
  "description": "DSH web plugin: right-click a selected text block in the conversation to \"quote it into context\" — it rides as one-shot injected context on your next real user message, without entering your message text.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.5",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "cordis": "^4.0.0-rc.7",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5"
  }
}
